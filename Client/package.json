{
  "name": "client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@microsoft/signalr-protocol-msgpack": "^10.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "pako": "^2.1.0",
    "phaser": "^3.90.0"
  },
  "build": {
    "appId": "com.arenasurvivor.game",
    "productName": "Arena Survivor",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}